# =============================================================================
# Переменные окружения проекта Volleyball Scoreboard
# Копия: cp .env.example .env
# =============================================================================
# Значения по умолчанию работают «из коробки» для локальной разработки.
# Для продакшена измените порты, пароли и отключите debug-режимы.

# -----------------------------------------------------------------------------
# Состав стека (Docker Compose)
# -----------------------------------------------------------------------------
# COMPOSE_FILE склеивает два файла, поэтому `docker compose up -d` поднимает
# сразу все контейнеры: pocketbase (из dockerfile.pb) + server + frontend.
# Без контейнера PocketBase (внешняя/хостовая БД):
#     docker compose -f docker-compose.yml up -d
COMPOSE_FILE=docker-compose.yml:docker-compose.pb.yml

# ------------------------------------------------------------------
# Авторизация
# ------------------------------------------------------------------
# 1 — авторизация включена (по умолчанию), 0 — режим гостя без входа.
# В гостевом режиме доступны создание/подключение игры и редактор шаблонов,
# вкладка «Админ» остаётся скрытой.
#
# Эта переменная влияет только на сервер (Node.js API): при ENABLE_AUTH=0
# серверные маршруты (scoreboard/matches) принимают запросы без токена.
# Для фронтенда (браузера) режим задаётся в credentials.js:
#     auth: { enabled: 0 }
ENABLE_AUTH=1

# -----------------------------------------------------------------------------
# Провайдер базы данных (поддерживается только pocketbase)
# -----------------------------------------------------------------------------
DB_PROVIDER=pocketbase

# -----------------------------------------------------------------------------
# Общие настройки портов (публикация из контейнеров)
# -----------------------------------------------------------------------------
# Порт PocketBase (только для docker-compose.pb.yml) — публикуется ТОЛЬКО
# на 127.0.0.1 хоста; снаружи БД закрыта, браузер ходит через прокси /pb/
POCKETBASE_PORT=8090

# Порт Node.js API сервера
API_PORT=3000

# Порт фронтенда (Nginx)
FRONTEND_PORT=8080

# -----------------------------------------------------------------------------
# PocketBase настройки (используются docker-compose.pb.yml / dockerfile.pb)
# -----------------------------------------------------------------------------
# Версия PocketBase, бинарник которой скачивает dockerfile.pb
PB_VERSION=0.36.6

# Режим работы PocketBase (production / development)
POCKETBASE_ENV=production

# Адрес PocketBase ВНУТРИ Docker-сети — его использует scripts/init-pocketbase.sh.
# Внутри контейнера PB всегда слушает 8090 (POCKETBASE_PORT — хостовой порт).
# POCKETBASE_INTERNAL_URL=http://pocketbase:8090

# Лимит памяти Go-рантайма (GOMEMLIMIT) для контейнера PocketBase
POCKETBASE_MEMORY_LIMIT=512MiB

# -----------------------------------------------------------------------------
# Node.js API сервер
# -----------------------------------------------------------------------------
# URL PocketBase.
#   docker-compose.pb.yml → http://pocketbase:8090 (имя сервиса внутри сети)
#   docker-compose.yml    → адрес внешнего PocketBase,
#                           например http://host.docker.internal:8090
POCKETBASE_URL=http://pocketbase:8090

# Админ-пароль PocketBase (если нужен API серверу для управления)
POCKETBASE_ADMIN_EMAIL=admin@volleyball.local
POCKETBASE_ADMIN_PASSWORD=changeme_in_production

# Разрешённые CORS origins (разделены пробелом или *)
ALLOWED_ORIGINS=*

# Режим Node.js (production / development)
API_NODE_ENV=production

# Swagger UI (включен по умолчанию в контейнере)
ENABLE_SWAGGER=true

# -----------------------------------------------------------------------------
# Фронтенд настройки (Nginx)
# -----------------------------------------------------------------------------
FRONTEND_HOST=localhost
