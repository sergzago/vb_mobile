# =============================================================================
# Переменные окружения Node.js API сервера
# Копия: cp .env.example .env
# =============================================================================
# Файл читается dotenv при запуске ВНЕ Docker (node src/index.js).
# В контейнере переменные приходят из docker-compose (.env сюда не монтируется).
# -----------------------------------------------------------------------------

# Порт, на котором слушает API сервер
PORT=3000

# URL PocketBase для запуска ВНЕ Docker: контейнер PB публикует порт только
# на 127.0.0.1 (см. docker-compose.pb.yml). В контейнере действует POCKETBASE_URL
# из корневого .env — http://pocketbase:8090 (внутри docker-сети).
POCKETBASE_URL=http://localhost:8090

# Админ-пароль PocketBase (нужен, если API сервер управляет коллекциями)
POCKETBASE_ADMIN_EMAIL=admin@volleyball.local
POCKETBASE_ADMIN_PASSWORD=changeme_in_production

# Разрешённые CORS origins (разделены пробелом или *)
ALLOWED_ORIGINS=*

# Режим Node.js (production / development)
NODE_ENV=production

# Swagger UI (включен по умолчанию в контейнере)
ENABLE_SWAGGER=true

# Режим авторизации API: 1 — токен обязателен (по умолчанию),
# 0 — гостевой режим: маршруты /api/scoreboard и /api/matches принимают
# запросы без токена (создание игры и шаблоны). Вкладка «Админ» при этом
# остаётся недоступной (requireAdmin).
# Для фронтенда (браузера) режим задаётся в credentials.js → auth.enabled.
ENABLE_AUTH=1
