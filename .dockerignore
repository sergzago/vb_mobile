# =============================================================================
# Общий .dockerignore — контекст ВСЕХ сборок (корень репозитория):
#   server/Dockerfile, Dockerfile.frontend, dockerfile.pb
# =============================================================================
# Цель: минимальный контекст и отсутствие лишнего в образах.
# Секреты (.env) в контекст и в образы не попадают.

# VCS / IDE / история редактора
.git
.github
.history
.idea
.idx
.mimocode
.vscode

# Данные и артефакты — только на хосте
deploy
pb_data
pb_migrations
logs
screenshots

# Зависимости
node_modules
server/node_modules

# Локальные конфиги и секреты
.env
server/.env
credentials.example.js

# Документация — приложению не нужна
*.md

# Дубликаты и экспорт, не участвующие в сборке фронтенда/сервера
logo_base64_.txt
pb_collection_*.json
