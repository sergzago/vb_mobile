# =============================================================================
# Volleyball Scoreboard — frontend (статика + nginx с прокси <APP_PREFIX>pb/ и <APP_PREFIX>api/)
# =============================================================================
# Контекст сборки — корень репозитория (см. корневой .dockerignore).
# Всё, что нужно браузеру, запекается в образ: на сервере НЕ нужны ни
# репозиторий, ни bind-mount'ы — только этот образ и шаблон nginx внутри него.
# =============================================================================
FROM nginx:alpine

# Префикс same-origin путей фронтенда (по умолчанию уникальный /vb/).
# Подставляется в шаблон конфига на старте контейнера (envsubst) и отдаётся
# браузеру через /vb-config.js → credentials.js. Переопределяется переменной
# окружения APP_PREFIX (docker-compose / .env) без пересборки образа.
# NGINX_ENVSUBST_FILTER ограничивает подстановку только APP_PREFIX, чтобы
# $переменные nginx в шаблоне не затрагивались.
ENV APP_PREFIX=/vb/ \
    NGINX_ENVSUBST_FILTER=APP_PREFIX

# Шаблон конфига nginx: статика + прокси <APP_PREFIX>pb/ и <APP_PREFIX>api/.
# nginx:alpine при старте рендерит /etc/nginx/templates/*.template →
# /etc/nginx/conf.d/default.conf (docker-entrypoint.d/20-envsubst-on-templates.sh).
COPY nginx.conf.template /etc/nginx/templates/default.conf.template

# Статика приложения. Список фиксированный: screenshots/, документация,
# логотипы-дубликаты и прочий мусор в образ не попадают.
COPY index.html mobile.html online.html results.html sb.html tablo.html \
     scoreboard.html login.html admin.html ctl.html \
     manifest.json sw.js logo_base64.txt \
     credentials.js vb-config.js \
     /usr/share/nginx/html/

COPY css /usr/share/nginx/html/css
COPY js  /usr/share/nginx/html/js
