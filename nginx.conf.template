server {
    listen 80;
    server_name localhost;

    # Корневая директория, откуда Nginx будет отдавать файлы
    root /usr/share/nginx/html;
    # Файл по умолчанию
    index mobile.html;

    # ----------------------------------------------------------------------------
    # PocketBase (API + realtime SSE): проксирование /pb/ в контейнер pocketbase.
    # Браузер (credentials.js → url '/pb/') ходит на тот же origin — без CORS.
    # resolver 127.0.0.11 — docker-embedded DNS; через переменную $pb_upstream
    # nginx стартует даже если контейнера pocketbase нет (внешняя/хостовая БД) —
    # тогда /pb/* ответит 502, остальное продолжит работать.
    # ----------------------------------------------------------------------------
    location /pb/ {
        resolver 127.0.0.11 valid=30s ipv6=off;
        set $pb_upstream http://pocketbase:8090;
        rewrite ^/pb/(.*)$ /$1 break;
        proxy_pass $pb_upstream;

        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # SSE realtime (/pb/api/realtime): без буферизации, долгий таймаут
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_set_header Connection '';
    }

    # Для корректной работы SPA (Single Page Application)
    # Все запросы, которые не находят файл, перенаправляются на mobile.html
    location / {
        try_files $uri $uri/ /mobile.html;
    }
}